# Copy this file to .env and fill in real values for local development.

SECRET_KEY=change-me-to-a-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Postgres connection string. When running via docker-compose this matches
# the `db` service defined in docker-compose.yml.
DATABASE_URL=postgres://issuehub:issuehub@localhost:5432/issuehub

# Origins allowed to call this API (comma separated).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Used to build links inside emails (verification, password reset).
FRONTEND_URL=http://localhost:5173

ACCESS_TOKEN_LIFETIME_MIN=15
REFRESH_TOKEN_LIFETIME_DAYS=7
EMAIL_TOKEN_EXPIRY_HOURS=48
PASSWORD_RESET_TOKEN_EXPIRY_HOURS=2

# Console backend prints emails to the terminal - good enough for local dev.
# Switch to django.core.mail.backends.smtp.EmailBackend + the EMAIL_HOST_*
# vars below to send real email.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=IssueHub <noreply@issuehub.local>

# --- RAG / AI assistant ------------------------------------------------------
# Defaults below need NO API key: retrieval uses a local embedding and answers
# are extractive snippets. To get generated answers, set RAG_LLM_PROVIDER to
# gemini/openai and provide the matching key (and pip install -r
# requirements-ai.txt). Full guide: docs/RAG_SETUP.md.
# RAG_EMBED_PROVIDER: local | gemini | openai | mock
RAG_EMBED_PROVIDER=local
# RAG_LLM_PROVIDER: none | gemini | openai | mock
RAG_LLM_PROVIDER=none
# RAG_VECTOR_BACKEND: memory | pgvector
RAG_VECTOR_BACKEND=memory
RAG_TOP_K=4
RAG_CHUNK_SIZE=512
RAG_CHUNK_OVERLAP=40
# RAG_EMBED_DIM: 256 local, 768 Gemini, 1536 OpenAI 3-small
RAG_EMBED_DIM=256

# Only needed when the matching provider is selected above.
GEMINI_API_KEY=
# GEMINI_EMBED_MODEL=models/text-embedding-004
# GEMINI_LLM_MODEL=models/gemini-1.5-flash
OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OPENAI_LLM_MODEL=gpt-4o-mini

# pgvector store connection (defaults to DATABASE_URL). Only used when
# RAG_VECTOR_BACKEND=pgvector.
# RAG_PGVECTOR_URL=postgres://issuehub:issuehub@localhost:5432/issuehub
